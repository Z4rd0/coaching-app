NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ANTHROPIC_API_KEY=
GARMIN_CLIENT_ID=        # placeholder — Garmin OAuth2 client ID
GARMIN_CLIENT_SECRET=    # placeholder — Garmin OAuth2 client secret

# Strava integration (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=        # numero intero da "My API Application" su Strava
STRAVA_CLIENT_SECRET=    # stringa da "My API Application" su Strava
STRAVA_STATE_SECRET=     # stringa random (es. openssl rand -hex 32) per firmare lo state OAuth

# ── Tredict ──────────────────────────────────────────────────────────────────
# Credenziali NON self-service: si richiedono via email a support@tredict.com
# (vedi TREDICT_INTEGRAZIONE.md nella root del repo).
# Finché sono vuote, /api/tredict/auth risponde 503 e il resto dell'app non cambia.
TREDICT_CLIENT_ID=
TREDICT_CLIENT_SECRET=
TREDICT_STATE_SECRET=    # stringa random distinta da quella Strava (openssl rand -hex 32)
TREDICT_SCOPE=           # opzionale, default "activityRead bodyvaluesRead"

# Email invites (Resend — https://resend.com)
RESEND_API_KEY=           # re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=        # noreply@tuodominio.it  (deve essere un dominio verificato su Resend)
NEXT_PUBLIC_APP_URL=      # http://localhost:3000 in dev | https://tuodominio.it in prod
